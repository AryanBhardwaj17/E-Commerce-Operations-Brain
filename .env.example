# Repo-root environment example.
# Use this as the default `.env` for full-stack local development and Docker Compose.
# The backend also reads these values when running from `backend/`.

# ── LLM Provider (choose one: azure, openai, or ollama) ─────────────────────
LLM_PROVIDER=azure

# ── Azure OpenAI ─────────────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://your-azure-openai-endpoint.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_DEPLOYMENT=your-chat-deployment-name
AZURE_EMBEDDING_DEPLOYMENT=your-embedding-deployment-name

# ── Standard OpenAI (used only when LLM_PROVIDER=openai) ────────────────────
OPENAI_API_KEY=your-openai-api-key

# ── Ollama (used only when LLM_PROVIDER=ollama) ─────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2
LLM_TEMPERATURE=1.2
LLM_MAX_TOKENS=2000

# ── LangSmith observability ─────────────────────────────────────────────────
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=ecommerce-ops-brain
LANGSMITH_TRACING=true

# ── PostgreSQL / repository storage / LangGraph checkpointing ──────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ops_brain
POSTGRES_USER=ops
POSTGRES_PASSWORD=ops
DATABASE_URL=postgresql://ops:ops@localhost:5432/ops_brain
CHECKPOINT_BACKEND=auto
REPOSITORY_BACKEND=postgres
REPOSITORY_SCHEMA=commerce

# ── ChromaDB ────────────────────────────────────────────────────────────────
CHROMADB_HOST=localhost
CHROMADB_PORT=8001

# ── API / runtime ───────────────────────────────────────────────────────────
API_KEY=change-me
CORS_ALLOWED_ORIGINS=http://localhost:3000
EXECUTION_BACKEND=in_process
WORKER_POLL_INTERVAL_SECONDS=1.0
RUNTIME_STORE_DIR=.runtime
APP_ENV=development
LOG_LEVEL=INFO

# ── Optional LangGraph state encryption ─────────────────────────────────────
LANGGRAPH_AES_KEY=

# ── OpenTelemetry ───────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=ecommerce-ops-brain